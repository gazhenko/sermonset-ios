{
  "name": "community-backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs dev --local --ip 127.0.0.1 --port 8787 --persist-to .wrangler/state",
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "check": "node scripts/check.mjs",
    "migrate": "node scripts/dev.mjs d1 migrations apply DB --local --persist-to .wrangler/state",
    "seed": "node scripts/seed.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "wrangler": "4.147.0",
    "miniflare": "5.20261001.0-alpha",
    "esbuild": "0.28.1"
  }
}
